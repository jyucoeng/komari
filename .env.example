# Image published by this fork. GitHub Actions publishes to ghcr.io/<owner>/<repo>:latest.
KOMARI_IMAGE=ghcr.io/your_github_username/komari:latest
KOMARI_VERSION=

# GitHub backup repository.
GH_BACKUP_USER=your_github_username
GH_REPO=your_private_repo_name
GH_BACKUP_BRANCH=main
GH_PAT=your_github_personal_access_token
GH_EMAIL=your_github_email@example.com

# Komari admin account used on first initialization.
ADMIN_USERNAME=yourusername
ADMIN_PASSWORD=yourpassword

# Cloudflare tunnel.
ARGO_DOMAIN=your-argo-domain.com
KOMARI_CLOUDFLARED_TOKEN=eyJxxxxx

# Backup schedule, UTC.
# 注意：BACKUP_TIME 的频率 × BACKUP_DAYS 决定了备份仓库里会积累多少个完整快照，
# 每次备份都会新增一个独立的 tar.gz 二进制对象，历史不会自动去重。
# 例如 0 */4 * * * + 15 天 = 最多 90 个包，仓库会迅速膨胀到 GB 级。
BACKUP_TIME="0 20 * * *"
BACKUP_DAYS=10
KOMARI_LOCK_TIMEOUT_SECONDS=60

# 备份排除项（相对 /app/data，空格分隔）。
# 默认排除 backup：那是面板自己产生的历史备份包，不排除就会「把旧备份装进新备份」。
# 主题/插件若可重新下载，可追加：BACKUP_EXCLUDE_PATHS="backup theme plugin-data"
BACKUP_EXCLUDE_PATHS="backup"

# 本地历史备份保留数量（/app/data/backup，面板自身产生的备份包）。
# 每次备份时按修改时间保留最新的 N 个，更早的自动删除；设为 0 表示不清理。
LOCAL_BACKUP_FILE_HISTORY_NUM=3

# 分卷：GitHub 对仓库内单个文件有 100MB 硬限制。压缩后超过该阈值时，
# 自动切成 komari-<时间>.tar.gz.part-NN-of-MM 多卷上传；还原时无需改动，
# README 里仍然只写不带分卷后缀的逻辑名。
#   0      = 禁用分卷（回到「超过 100MB 直接报错」）
#   1 - 99 = 启用分卷（默认 95，给硬限留 5MB 余量）
BACKUP_SPLIT_SIZE_MB=95

# 是否在压缩前先估算体积：1 开启 / 0 关闭。
# 估算只用于选择「单文件」还是「流式分卷」（后者峰值磁盘占用减半），
# 最终产出由压缩后的实测大小决定，因此估算偏差不会导致错误结果。
BACKUP_SPLIT_PRE_ESTIMATE=1

# 估算安全系数（百分比）：宁可高估提前分卷，不可低估。
BACKUP_ESTIMATE_SAFETY_PCT=115

# Script auto update. Set to 1 to disable daily script updates.
NO_AUTO_RENEW=

# Caddy reverse proxy.
CADDY_PROXY_PORT=8001
CADDY_VERSION=2.9.1
XRAY_VLESS_PORT=8002
XRAY_VMESS_PORT=8003

# Disable Komari web SSH/terminal and remote command features by default. Set both to 0 to allow them.
KOMARI_DISABLE_WEB_SSH=1
KOMARI_DISABLE_REMOTE=1

# Optional subscription endpoint.
UUID=
CF_IP=ip.sb
SUB_HOST=
SUB_SNI=
SUB_NAME=komari
